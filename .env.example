# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== Upstream Betabotz =====
BETABOTZ_API_URL=https://api.betabotz.eu.org/api/tools
BETABOTZ_AKSES_KEY=

# ===== Sesi & nonce =====
# 32 byte hex. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Salt untuk hash IP. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_SALT=

# ===== Cloudflare Turnstile =====
# Kosongkan keduanya untuk mematikan captcha saat development.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Set true untuk mematikan captcha walau key terisi.
TURNSTILE_DISABLED=true

# ===== Domain =====
# URL publik tanpa trailing slash, contoh: https://am.domainkamu.com
SITE_URL=http://localhost:3000
# Origin tambahan dipisah koma (preview Vercel, domain custom, dll.)
ALLOWED_ORIGINS=

# ===== Kill switch =====
MAINTENANCE=false
